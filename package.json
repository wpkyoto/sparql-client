{
  "name": "sparql-builder",
  "version": "1.0.0",
  "description": "Type-safe SPARQL query builder and client for JavaScript/TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sparql",
    "query-builder",
    "rdf",
    "semantic-web",
    "typescript",
    "sparql-client",
    "sparql-query"
  ],
  "bugs": {
    "url": "https://github.com/hideokamoto/sparql-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/sparql-client.git"
  },
  "author": "Hidetaka Okamoto <info@wp-kyoto.net> (https://wp-kyoto.net)",
  "license": "MIT",
  "dependencies": {
    "@rdfjs/types": "^1.1.0",
    "sparql-http-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.1",
    "@types/sparql-http-client": "^3.0.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
